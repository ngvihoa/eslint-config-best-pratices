{
  "name": "@ngvihoa/eslint-config-best-practices",
  "version": "0.1.0",
  "description": "Reusable ESLint flat config presets for JavaScript, TypeScript, React, Next.js, and Node projects.",
  "license": "MIT",
  "type": "commonjs",
  "main": "index.cjs",
  "exports": {
    ".": "./index.cjs",
    "./base": "./configs/base.cjs",
    "./next": "./configs/next.cjs",
    "./node": "./configs/node.cjs",
    "./typescript": "./configs/typescript.cjs",
    "./react": "./configs/react.cjs"
  },
  "files": [
    "configs",
    "docs",
    "index.cjs",
    "README.md"
  ],
  "scripts": {
    "lint": "eslint .",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "eslint",
    "eslint-config",
    "flat-config",
    "javascript",
    "next",
    "nextjs",
    "typescript",
    "react"
  ],
  "peerDependencies": {
    "eslint": ">=9"
  },
  "dependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.10",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.7.0",
    "typescript-eslint": "8.62.1"
  },
  "devDependencies": {
    "eslint": "9.39.4"
  }
}
